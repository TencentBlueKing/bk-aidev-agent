# craw_local_sim 凭据/环境模板：cp agent.env.example agent.env 后按注释填写。
# agent.env 已 gitignore——真实 token / 内部域名只写在 agent.env，绝不提交。

# ===== 通用（三个变体都需要）=====
# AIDEV 用户态 token（craw 内核调 AIDEV 平台用）
BKAI_ACCESS_TOKEN=your-aidev-user-token
# AIDEV 平台上的 agent code（craw 内核加载哪个 agent 配置）
BKAI_AGENT=your-agent-code
# agent 侧镜像：任意含 SDK 运行依赖（/app/.venv）的镜像，如你的业务插件镜像
AGENT_IMAGE=your-plugin-image:dev

# ===== plugin 变体（真实 Django 插件整链）=====
APP_CODE=your-app-code
APP_SECRET=your-app-secret
# 业务插件 bk_plugin 目录的绝对路径（挂进容器 /app/bk_plugin）
PLUGIN_SRC=/path/to/your-plugin/bk_plugin
# 蓝鲸网关地址模板（{api_name} 为字面占位符，按你的部署环境填写）
BK_API_URL_TMPL=http://{api_name}.apigw.example.com
# 以下按需覆盖（不设则用 compose 里的占位默认值）
# BKPAAS_APIGW_OAUTH_API_URL=http://apigw.example.com
# BKPAAS_BK_DOMAIN=example.com
# BKPAAS_LOGIN_URL=http://login.example.com
# BKPAAS_URL=http://paas.example.com
# BKPAAS_ENGINE_REGION=default
# AIDEV_GATEWAY_NAME=bkaidev
# BK_APIGW_STAGE=prod

# ===== hermes 变体 =====
HERMES_IMAGE=your-hermes-image:latest

# ===== Token 隔离实测（run-isolation.sh）=====
# BKAI_CLI_SRC=/path/to/bkai-cli
# REAL_MCP_ACCESS_TOKEN=your-valid-user-token
# FAKE_MCP_ACCESS_TOKEN=any-fake-string
