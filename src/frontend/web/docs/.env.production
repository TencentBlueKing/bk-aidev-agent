# 生产构建占位（Vite 不会把 BK_* 打进 bundle）
# 运行时由 createDocsMiddleware / server.cjs 的 globals 注入 window.BK_*

# 网站前缀
BK_SITE_URL = '{{ SITE_URL }}'

# 静态资源路径
BK_STATIC_URL = '{{ BK_STATIC_URL }}'

# AIDev 平台主站地址（顶栏「返回 AIDev」）
BK_AIDEV_URL = '{{ BK_AIDEV_URL }}'

# 在线 Demo 的智能体 API
BK_AIDEV_API_URL = '{{ BK_AIDEV_API_URL }}'
