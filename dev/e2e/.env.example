# Local E2E identity. E2E_ACCESS_TOKEN takes precedence over E2E_USERNAME.
E2E_USERNAME=e2e-user
E2E_ACCESS_TOKEN=
E2E_TOKEN_USERNAME=e2e-token-user

# Runner options.
E2E_MODULES=api,ai-blueking,metrics
E2E_HEADLESS=true
E2E_DB=sqlite
E2E_APP_URL=http://127.0.0.1:18000
E2E_MOCK_URL=http://127.0.0.1:18080
E2E_REPORT_DIR=dev/e2e/reports

# Real local storage dependencies. SQLite is the default application database;
# set E2E_DB=mysql and start with db=mysql to use the optional MySQL 5.7 profile.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_NAME=aidev_agent_e2e
MYSQL_USER=aidev
MYSQL_PASSWORD=aidev-e2e
MESSAGE_REDIS_URL=redis://127.0.0.1:16379/0
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=15673
RABBITMQ_USER=aidev
RABBITMQ_PASSWORD=aidev-e2e
RABBITMQ_VHOST=/

# OpenTelemetry -> local Collector -> Prometheus -> Grafana.
E2E_OBSERVABILITY=true
BKAI_AGENT_OTEL_ENABLED=true
BKAI_AGENT_ENABLE_METRICS=true
BKAI_AGENT_OTEL_ENDPOINTS=[{"url":"http://127.0.0.1:4318","exporter_type":"http"}]
