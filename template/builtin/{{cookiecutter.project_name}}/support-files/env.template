export PYTHONPATH=$PWD
export BK_APP_CONFIG_PATH=bk_plugin_runtime.config
export DJANGO_SETTINGS_MODULE=bk_plugin.patch.plugin
export BK_SOPS_APP_CODE=bksops
export DJANGO_ALLOW_ASYNC_UNSAFE=True

# 应用配置
export BKPAAS_APP_ID={{ cookiecutter.app_code }}
export BKPAAS_APP_SECRET=PLEASE_UPDATE_HERE
export AIDEV_SPACE_ID={{ cookiecutter.extra_fields.space_id }}
export AIDEV_GATEWAY_NAME={{ cookiecutter.aidev_gateway_name }}
export BK_APIGW_STAGE={{ cookiecutter.bk_apigw_stage }}

# Agent 指标本地上报（显式 false 优先于平台下发的 Agent 配置）
export BKAI_AGENT_ENABLE_METRICS=false
# 指标上报周期（毫秒）；本地配置优先，未配置时使用平台 export_interval_millis，最小 10000
export BKAI_AGENT_METRICS_EXPORT_INTERVAL_MILLIS=10000
# 周期快照推送方式：celery（默认异步入队）或 direct（周期线程直接请求 BKM）；平台 push_mode 优先
export BKAI_AGENT_METRICS_PUSH_MODE=celery
# BKM 自定义指标协议；平台 agent_* 优先，本地配置作为回退
export BKAI_AGENT_METRICS_HOST=
export BKAI_AGENT_METRICS_DATA_ID=
export BKAI_AGENT_METRICS_TOKEN=
export BKAI_AGENT_METRICS_TARGET=
# 指标快照在 Celery 中的最大等待时间；平台 task_ttl_seconds 优先，超时后 Worker 直接丢弃
export BKAI_AGENT_METRICS_TASK_TTL_SECONDS=3600

# 平台内置环境变量：可在【开发者中心 > 模块配置 > 环境变量 > 查看内置环境变量】获取
export BK_APIGW_MANAGER_URL_TMPL={{cookiecutter.apigw_manager_url_tmpl}}
export BK_API_URL_TMPL={{cookiecutter.apigw_manager_url_tmpl}}
export BKPAAS_APIGW_OAUTH_API_URL={{cookiecutter.bkpaas_apigw_oauth_api_url}}
export BKPAAS_BK_DOMAIN={{cookiecutter.bkpaas_bk_domain}}
export BKPAAS_ENGINE_REGION={{cookiecutter.bkpaas_engine_region}}
export BKPAAS_LOGIN_URL={{cookiecutter.bkpaas_login_url}}
export BKPAAS_URL={{cookiecutter.bkpaas_url}}
